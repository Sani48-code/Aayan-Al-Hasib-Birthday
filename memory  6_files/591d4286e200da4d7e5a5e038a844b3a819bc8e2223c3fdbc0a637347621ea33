  iframe.src = "https://app.minniyo.com/chat/iframe?%3D%3D&color=%23f1d51f";
  iframe.className =
    "minniyo-chatbot-iframe minniyo-chatbot-iframe--" +
    widgetPosition.split("-")[0];
  iframe.style.cssText = [
    "position: fixed",
    "border: none",
    "border-radius: 12px",
    "box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25)",
    "z-index: 999998",
    "background: white",
    "display: none",
  ].join(";");

  // Function to hide greeting bubble
  function hideGreeting() {
    if (greetingVisible) {
      greetingVisible = false;
      greetingBubble.classList.add("slide-out");
      setTimeout(function () {
        greetingBubble.style.display = "none";
        // Show external button after greeting is hidden
        if (!externalButtonVisible) {
          externalButtonVisible = true;
          externalButton.style.display = "flex";
        }
      }, 300);
    }
  }

  // Function to set iframe dimensions based on device
  function setIframeDimensions() {
    iframe.style.top = "auto";
    iframe.style.bottom = "auto";
    iframe.style.left = "auto";
    iframe.style.right = "auto";
    iframe.style.transform = "none";
    iframe.style.setProperty("--minniyo-iframe-x", "0px");

    if (isMobile) {
      iframe.style.width = "90vw";
      iframe.style.height = "90vh";
      iframe.style.top = "5vh";
      iframe.style.left = "5vw";
    } else {
      var parts = widgetPosition.split("-");
      var vertical = parts[0];
      var horizontal = parts[1];

      iframe.style.width = "336px";
      iframe.style.height = "576px";
      iframe.style[vertical] = "30px";

      if (horizontal === "left") {
        iframe.style.left = "25px";
      } else if (horizontal === "center") {
        iframe.style.left = "50%";
        iframe.style.transform = "translateX(-50%)";
        iframe.style.setProperty("--minniyo-iframe-x", "-50%");
      } else {
        iframe.style.right = "25px";
      }
    }
  }

  // Function to show the chatbot
  function showChatbot() {
    if (!isOpen) {
      isOpen = true;
      hideGreeting();
      setIframeDimensions();
      iframe.style.animation = "none";
      iframe.style.display = "block";
      void iframe.offsetWidth;
      iframe.style.animation = "";
      buttonContainer.style.display = "none";

      // Send message to iframe that it's opened
      setTimeout(function () {
        iframe.contentWindow.postMessage({ action: "open" }, "*");
      }, 100);
    }
  }

  // Function to hide the chatbot
  function hideChatbot() {
    if (isOpen) {
      isOpen = false;
      iframe.style.display = "none";
      buttonContainer.style.display = "flex";

      // Send message to iframe that it's closed
      iframe.contentWindow.postMessage({ action: "close" }, "*");
    }
  }

  // Handle button click
  button.addEventListener("click", showChatbot);

  function handleGreetingClick(e) {
    // Don't trigger if clicking on external link or close button
    if (
      e.target === externalIcon ||
      e.target.closest("a") ||
      e.target === closeButton
    ) {
      return;
    }
    showChatbot();
  }

  function handleGreetingClose(e) {
    e.stopPropagation();
    hideGreeting();
  }

  // Handle greeting bubble and close button clicks
  greetingBubble.addEventListener("click", handleGreetingClick);
  closeButton.addEventListener("click", handleGreetingClose);

  // Auto-hide greeting after 8 seconds
  var greetingTimeout = setTimeout(function () {
    hideGreeting();
  }, 8000);

  function messageHandler(event) {
    if (event.data && event.data.action === "close") {
      hideChatbot();
    }
  }

  // Listen for close messages from iframe
  window.addEventListener("message", messageHandler);

  // expose the hideChatbot and showChatbot function to global scope
  window.hideMinniyoChat = hideChatbot;
  window.showMinniyoChat = showChatbot;
  window.showMinniyoButton = () => (buttonContainer.style.display = "flex");
  window.hideMinniyoButton = () => (buttonContainer.style.display = "none");

  function resizeHandler() {
    var wasMobile = isMobile;
    isMobile = window.innerWidth <= 768;

    if (wasMobile !== isMobile) {
      updateLauncherSizes();
      applyButtonPosition();

      // Update iframe if open
      if (isOpen) {
        setIframeDimensions();
      }
    }
  }

  // Handle window resize
  window.addEventListener("resize", resizeHandler);

  function keydownHandler(e) {
    if (e.key === "Escape" && isOpen) {
      hideChatbot();
    }
  }

  // Add ESC key listener to close chatbot
  document.addEventListener("keydown", keydownHandler);

  // Wait for DOM to be ready before appending
  function initialize() {
    document.body.appendChild(buttonContainer);
    document.body.appendChild(iframe);
  }

  function cleanup() {
    // Remove event listeners
    button.removeEventListener("click", showChatbot);
    greetingBubble.removeEventListener("click", handleGreetingClick);
    closeButton.removeEventListener("click", handleGreetingClose);
    window.removeEventListener("message", messageHandler);
    window.removeEventListener("resize", resizeHandler);
    document.removeEventListener("keydown", keydownHandler);
    document.removeEventListener("DOMContentLoaded", initialize);
    clearTimeout(greetingTimeout);

    // Remove elements
    if (buttonContainer.parentNode) {
      buttonContainer.parentNode.removeChild(buttonContainer);
    }
    if (iframe.parentNode) {
      iframe.parentNode.removeChild(iframe);
    }
    if (style.parentNode) {
      style.parentNode.removeChild(style);
    }

    // Clear global functions
    delete window.showMinniyoChat;
    delete window.hideMinniyoChat;
    delete window.showMinniyoButton;
    delete window.hideMinniyoButton;
    delete window.cleanupMinniyo;
  }

  // expose the cleanup function to global scope
  window.cleanupMinniyo = cleanup;

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initialize);
  } else {
    initialize();
  }
})();
