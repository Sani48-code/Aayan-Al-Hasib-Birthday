    ? appearance.position
    : "bottom-right";
  var introSize = ["sm", "md", "lg"].includes(appearance.intro_size)
    ? appearance.intro_size
    : "md";
  var chatbotMedia = {
    mode: 'video',
    image: null,
    gif: 'https:\/\/app.minniyo.com\/uploads\/chatbots\/intro_gif\/chatbot_5_6a3e1b613c808.gif',
    gifStatus: 'ready',
    avatar: 'https:\/\/app.minniyo.com\/uploads\/chatbots\/avatars\/images_6a3e1e82ad2ed9.01924901.jpeg',
  };
  var launcherMediaUrl = chatbotMedia.avatar;

  if (chatbotMedia.mode === "image" && chatbotMedia.image) {
    launcherMediaUrl = chatbotMedia.image;
  } else if (
    chatbotMedia.mode === "video" &&
    chatbotMedia.gifStatus === "ready" &&
    chatbotMedia.gif
  ) {
    launcherMediaUrl = chatbotMedia.gif;
  }

  function getLauncherMetrics() {
    var sizeMap = isMobile
      ? { sm: 64, md: 80, lg: 96 }
      : { sm: 80, md: 104, lg: 128 };
    var avatar = sizeMap[introSize];

    return {
      avatar: avatar,
      ping: Math.round(avatar * 0.64),
      indicator: Math.round(avatar * 0.16),
      indicatorBorder: Math.max(2, Math.round(avatar * 0.022)),
      indicatorInset: Math.max(3, Math.round(avatar * 0.04)),
