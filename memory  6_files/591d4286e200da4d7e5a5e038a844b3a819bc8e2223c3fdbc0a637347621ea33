  }

  // Add CSS animations and styles
  var style = document.createElement("style");
  style.textContent = `
    @keyframes minniyo-fadeIn-kf {
        from { opacity: 0; transform: scale(0.8); }
        to { opacity: 1; transform: scale(1); }
    }
    
    @keyframes minniyo-ping-kf {
        0% { transform: scale(1); opacity: 0.3; }
        75%, 100% {
          transform: scale(2.3);
          opacity: 0;
        }
    }
    
    @keyframes minniyo-slideInRight-kf {
        from { 
          opacity: 0; 
          transform: translateX(20px) scale(0.8); 
        }
        to { 
          opacity: 1; 
          transform: translateX(0) scale(1); 
        }
    }
    
    @keyframes minniyo-slideOutRight-kf {
        from { 
          opacity: 1; 
          transform: translateX(0) scale(1); 
        }
        to { 
          opacity: 0; 
          transform: translateX(20px) scale(0.8); 
        }
    }

    @keyframes minniyo-chatOpen-kf {
        from {
          opacity: 0;
          transform: translate(
            var(--minniyo-iframe-x, 0),
            var(--minniyo-iframe-y, 18px)
          ) scale(0.96);
        }
        to {
          opacity: 1;
          transform: translate(var(--minniyo-iframe-x, 0), 0) scale(1);
        }
    }
    
    .minniyo-fade-in {
      animation: minniyo-fadeIn-kf 0.3s ease-out;
    }
    
    .minniyo-ping {
      animation: minniyo-ping-kf 1.2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    
    .minniyo-chatbot-button:hover .minniyo-ping-span {
      display: none;
    }
    
    .minniyo-chatbot-iframe {
      --minniyo-iframe-y: 18px;
      animation: minniyo-chatOpen-kf 0.38s cubic-bezier(0.22, 1, 0.36, 1);
      transform-origin: bottom center;
    }

    .minniyo-chatbot-iframe--top {
      --minniyo-iframe-y: -18px;
      transform-origin: top center;
    }
    
    .minniyo-greeting-bubble {
      animation: minniyo-slideInRight-kf 0.4s ease-out;
    }
    
    .minniyo-greeting-bubble.slide-out {
      animation: minniyo-slideOutRight-kf 0.3s ease-in forwards;
    }

    .minniyo-greeting-bubble:hover #minniyo-greeting-close-button {
      opacity: 1 !important;
    }
    
    .minniyo-external-icon {
      transition: transform 0.2s ease;
    }
    
    .minniyo-external-icon:hover {
      transform: scale(1.1);
    }
    
    .minniyo-external-button {
      animation: minniyo-slideInRight-kf 0.4s ease-out;
    }
    
